# ==========================================
# Discord Economy & Entertainment Bot - Config
# ==========================================

# Discord Bot Credentials (from Discord Developer Portal -> Bot / OAuth2)
DISCORD_TOKEN=your_discord_bot_token_here
CLIENT_ID=your_discord_application_client_id_here
GUILD_ID=your_target_discord_server_id_here

# Turso / libSQL Remote Database Credentials (from Turso CLI or dashboard.turso.tech)
# Example URL: libsql://your-db-name-your-org.turso.io
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your_turso_database_auth_token_here

# Server & Runtime Configuration
PORT=8080
NODE_ENV=development

# Activity Reward Channels
# Leave blank to disable that activity category.
CAMERA_ROLL_CHANNEL_ID=
GENERAL_CHAT_CHANNEL_ID=
OPEN_CHAT_CHANNEL_IDS=
